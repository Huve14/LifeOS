# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# AI proxy (Cloudflare Worker or local server.cjs)
# VITE_API_URL=https://suveda-proxy.your-name.workers.dev
NVIDIA_API_KEY=your-nvidia-api-key

# Live audio and video calling. Hidden by default: the UAE reserves consumer
# voice and video over IP for licensed operators. Leave both ENABLE flags unset
# for a UAE deployment. Only the exact string "true" opts in. See docs/CALLS.md.
# VITE_ENABLE_CALLS=true
# ENABLE_CALLS=true

# Must be wss on port 443; anything else is refused at the call screen.
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud

# Server only, never exposed to the browser. Set these on Vercel.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SUPABASE_URL=
SUPABASE_ANON_KEY=
