{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/deepseek.js": {
      "maxDuration": 60
    },
    "api/livekit-token.js": {
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/s/:token",
      "destination": "/shared.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
