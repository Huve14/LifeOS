{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/deepseek.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/s/:token", "destination": "/shared.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
